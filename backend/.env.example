PORT=5001
JWT_SECRET=your_jwt_secret_key_here
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/leukolion?schema=public

# MERNİS Gerçek NVİ Servisi veya Test Modu (true: bypass, false: gerçek NVİ SOAP)
BYPASS_MERNIS=true

# SMTP E-Posta Yapılandırması
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# İzin verilen CORS originleri (virgülle ayrılmış)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

